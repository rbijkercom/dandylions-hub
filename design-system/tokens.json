{
  "$meta": {
    "brand": "DandyLions",
    "tagline": "REFLECTION IN MOTION",
    "sources": [
      "rbijkercom/dandy-lions main: src/app/(frontend)/styles.css and docs/design-system.md (Figma DS sync of 7 Oct 2026, PR #21, branch ruben/figma-ds-sync-oct7)",
      "Figma file ADAT7igJnBG5nvij5shy9V, page '01 — Brand & system', section 'Full Design System' (variables) and 'Brand identity style guide'"
    ],
    "note": "Curated tokens for content creation. When the site and Figma disagree, the site (code) wins. design-system/upstream/ holds the raw synced files.",
    "updated": "2026-10-08"
  },
  "color": {
    "primitives": {
      "ivory": { "hex": "#F5F2EC", "rgb": "245 242 236", "role": "Primary canvas (Light theme page)" },
      "sage": { "hex": "#748262", "rgb": "116 130 98", "role": "Signature field, large areas (Inverted theme page)" },
      "charcoal": { "hex": "#2D2D2D", "rgb": "45 45 45", "role": "Primary text and ink, logo on Light" },
      "gold": { "hex": "#907948", "rgb": "144 121 72", "role": "Quiet accent, hover fill, rules and seeds" },
      "gold-deep": { "hex": "#7A663C", "rgb": "122 102 60", "role": "Accent text (overlines) on ivory, pressed gold" },
      "pale-sage": { "hex": "#C6CAB9", "rgb": "198 202 185", "role": "Soft surface, selection, photo placeholders" },
      "body-ink": { "hex": "#454340", "rgb": "69 67 64", "role": "Body text on ivory and cards" },
      "card-surface": { "hex": "#FBF9F4", "rgb": "251 249 244", "role": "Content cards" },
      "card-border": { "hex": "#E3DDCE", "rgb": "227 221 206", "role": "Card outline and divider" },
      "control-fill": { "hex": "#E9E8DF", "rgb": "233 232 223", "role": "Button and pill fill" },
      "control-border": { "hex": "#CFCEC6", "rgb": "207 206 198", "role": "Pill and divider borders" },
      "selected-sand": { "hex": "#C3C0A6", "rgb": "195 192 166", "role": "Selected tab segment, pressed button" },
      "option-hover": { "hex": "#F1EEE6", "role": "Hover on menu options" },
      "selector-border": { "hex": "#B0B3A5", "role": "Selection border" },
      "error": { "hex": "#9E3B2B", "role": "Feedback error on Light" },
      "error-deep": { "hex": "#FF9F9F", "role": "Feedback error on Inverted (sage)" }
    },
    "accents": {
      "sage-muted": { "hex": "#7C866D", "role": "Icon and number badges" },
      "wine": { "hex": "#632631", "role": "Icon and number badges" },
      "ochre": { "hex": "#AA8653", "role": "Icon and number badges" },
      "forest": { "hex": "#183930", "role": "Icon and number badges" }
    },
    "retired": {
      "sage-original": { "hex": "#7F8D6C", "note": "Reference only. Previous sage. Do not use." },
      "sage-deep": { "hex": "#646F55", "note": "Does not exist in the system. Inverted surfaces are sage #748262." }
    },
    "contrastPairs": [
      { "pair": "ivory + charcoal", "ratio": "12.3:1", "use": "Any size" },
      { "pair": "ivory + gold-deep", "ratio": "4.9:1", "use": "Overlines and accents" },
      { "pair": "sage + ivory", "ratio": "3.68:1", "use": "Large text only (24 px and up)" },
      { "pair": "charcoal + ivory", "ratio": "12.3:1", "use": "Gold only for rules and seeds on charcoal" }
    ]
  },
  "themes": {
    "light": {
      "name": "Light (ivory)",
      "usedFor": "Insights, About, and the ivory content band on Consulting",
      "selector": "[data-theme='light'], .tone-light",
      "surface": { "page": "#F5F2EC", "raised": "#E9E8DF", "card": "#FBF9F4" },
      "text": { "primary": "#2D2D2D", "body": "#454340", "dimmed": "rgb(45 45 45 / 75%)", "accent": "#7A663C", "inverse": "#F5F2EC" },
      "brand": { "accent": "#907948", "logo": "#2D2D2D" },
      "border": { "subtle": "#CFCEC6", "control": "#2D2D2D", "card": "#E3DDCE" },
      "button": { "secondaryFill": "#E9E8DF", "secondaryHoverFill": "#907948", "border": "#CFCEC6", "pressedFill": "#C3C0A6" },
      "feedback": { "error": "#9E3B2B" },
      "focusRing": "#2D2D2D",
      "shadowHover": "rgb(144 121 72 / 20%)"
    },
    "inverted": {
      "name": "Inverted (sage)",
      "usedFor": "Consulting header, hero and footer",
      "selector": "[data-theme='inverted'], .tone-sage",
      "surface": { "page": "#748262", "raised": "#748262", "card": "#FBF9F4", "cardThemed": "#748262" },
      "text": { "primary": "#F5F2EC", "body": "#F5F2EC", "dimmed": "#F5F2EC", "accent": "#F5F2EC", "inverse": "#2D2D2D" },
      "brand": { "accent": "#F5F2EC", "logo": "#F5F2EC" },
      "border": { "subtle": "rgb(245 242 236 / 35%)", "control": "#F5F2EC", "card": "#E3DDCE" },
      "button": { "secondaryFill": "rgb(45 45 45 / 12%)", "secondaryHoverFill": "#F5F2EC", "border": "rgb(245 242 236 / 35%)", "pressedFill": "#C3C0A6" },
      "feedback": { "error": "#FF9F9F" },
      "focusRing": "#F5F2EC",
      "shadowHover": "rgb(144 121 72 / 20%)"
    },
    "note": "There is no charcoal 'dark' theme on the site. Charcoal backgrounds appear only in some social templates."
  },
  "typography": {
    "families": {
      "serif": { "name": "Cormorant Garamond", "weights": ["300 Light", "400 Regular", "400 Italic", "600 SemiBold"], "use": "Headings, brand, quotes, ledes, editorial paragraphs", "fallback": "Georgia, 'Times New Roman', serif" },
      "sans": { "name": "Hanken Grotesk", "weights": ["400 Regular"], "use": "Body, lists, card copy, labels, UI controls", "fallback": "Arial, Helvetica, sans-serif" }
    },
    "scale": {
      "display": { "family": "serif", "weight": 300, "size": "44px mobile / 60px from 768px", "lineHeight": 1.04, "letterSpacing": "-3%" },
      "h1": { "family": "serif", "weight": 400, "size": "32px mobile / 40px desktop", "lineHeight": "36px / 46px", "letterSpacing": "-0.32px / -0.4px" },
      "h2": { "family": "serif", "weight": 400, "size": "32px", "lineHeight": "38px", "letterSpacing": "-0.32px" },
      "h3": { "family": "serif", "weight": 400, "size": "24px", "lineHeight": "30px", "letterSpacing": "-0.24px" },
      "h4": { "family": "serif", "weight": 400, "size": "20px", "lineHeight": "26px" },
      "lead": { "family": "serif", "weight": 300, "size": "20px mobile / 28px desktop", "lineHeight": 1.44 },
      "reading": { "family": "serif", "weight": 300, "size": "18–24px", "lineHeight": 1.42, "letterSpacing": "-0.005em" },
      "supportingItalic": { "family": "serif", "weight": 400, "style": "italic", "size": "22px", "lineHeight": "30px" },
      "emphasis": { "family": "serif", "weight": 600, "size": "20px", "lineHeight": "26px" },
      "routeTitle": { "family": "serif", "weight": 400, "size": "46px", "lineHeight": "58px", "letterSpacing": "-0.46px" },
      "wordmark": { "family": "serif", "weight": 300, "size": "34–84px", "lineHeight": 0.95, "letterSpacing": "-0.035em" },
      "bodyLarge": { "family": "sans", "weight": 400, "size": "18px", "lineHeight": "28px" },
      "body": { "family": "sans", "weight": 400, "size": "16px", "lineHeight": "24px" },
      "bodySmall": { "family": "sans", "weight": 400, "size": "14px", "lineHeight": "21px" },
      "caption": { "family": "sans", "weight": 400, "size": "12px", "lineHeight": "18px" },
      "uiLabel": { "family": "sans", "weight": 400, "size": "14px", "lineHeight": "20px", "letterSpacing": "1.5px", "transform": "uppercase" },
      "uiControl": { "family": "sans", "weight": 400, "size": "12px", "lineHeight": "20px", "letterSpacing": "1.2px", "transform": "uppercase" },
      "overline": { "family": "sans", "weight": 400, "size": "11px", "lineHeight": "20px", "letterSpacing": "2.4px", "transform": "uppercase" }
    },
    "socialScale": {
      "headlinesAndQuotes": "Cormorant Garamond Light/Regular, 88–128 px",
      "supportingLines": "Cormorant Garamond Italic, 34–44 px",
      "body": "Hanken Grotesk Regular, 22–32 px",
      "overlines": "Hanken Grotesk caps with wide tracking, 18–22 px",
      "source": "Figma Social media pack, Pack guide"
    }
  },
  "spacing": {
    "scale": [4, 8, 12, 16, 24, 32, 48, 64, 80, 96, 120],
    "sectionGap": 96,
    "pageMargin": { "mobile": 24, "tablet": 48, "desktop": 64 },
    "gridGutter": { "mobile": 16, "tabletUp": 24 },
    "gridColumnsMobile": 4,
    "contentMaxWidth": 1312,
    "readingMeasure": 720,
    "controlMin": 44,
    "breakpoints": [768, 1200],
    "unit": "px"
  },
  "radius": { "pill": 999, "card": 12, "field": 8, "small": 4 },
  "effects": {
    "grain": {
      "description": "Fixed paper-grain overlay on ivory and sage (feTurbulence fractalNoise, baseFrequency 0.85), 150px tile",
      "opacity": 0.035,
      "asset": "https://dandy-lions.vercel.app/brand/grain.png"
    },
    "hoverLift": { "type": "drop-shadow", "offset": "0 8px", "blur": 16, "color": "rgb(144 121 72 / 20%)" }
  },
  "motion": { "ease": "cubic-bezier(0.33, 0, 0.15, 1)" }
}
